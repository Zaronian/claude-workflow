#!/bin/bash
# Pre-commit hook to prevent accidental secret commits
# Copy to .git/hooks/pre-commit and make executable
#
# To install in any git repo:
#   cp ~/.scratch/hooks/pre-commit-secrets .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit

echo "Running pre-commit secret check..."

# Patterns that indicate potential secrets (POSIX ERE compatible for macOS grep)
PATTERNS=(
    $'password[[:space:]]*=[[:space:]]*["\'"]'
    $'api_key[[:space:]]*=[[:space:]]*["\'"]'
    $'secret[[:space:]]*=[[:space:]]*["\'"]'
    'AWS_SECRET'
    'PRIVATE_KEY'
    'DATABASE_URL.*@'
    'postgres://.*:.*@'
    'mysql://.*:.*@'
    'sk-[a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9]'
    'ghp_[a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9]'
    'gho_[a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9]'
    'phc_[a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9]'
    'xoxb-[a-zA-Z0-9-]+'
    'xoxp-[a-zA-Z0-9-]+'
)

# Files to always block (regex patterns, not globs)
BLOCKED_FILES=(
    '\.env$'
    '\.env\.local$'
    '\.env\.production$'
    'credentials\.json$'
    '\.pem$'
    '\.key$'
    'id_rsa$'
    'id_ed25519$'
)

# Check for blocked files
for pattern in "${BLOCKED_FILES[@]}"; do
    if git diff --cached --name-only | grep -E "$pattern" > /dev/null; then
        echo "ERROR: Attempting to commit potentially sensitive file matching: $pattern"
        echo "If this is intentional, use: git commit --no-verify"
        exit 1
    fi
done

# Check staged files for secret patterns
FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(py|js|ts|json|yaml|yml|sh|env|conf|config|md)$')

if [ -n "$FILES" ]; then
    for pattern in "${PATTERNS[@]}"; do
        MATCHES=$(git diff --cached -U0 $FILES 2>/dev/null | grep -E "^\+" | grep -iE "$pattern" || true)
        if [ -n "$MATCHES" ]; then
            echo "WARNING: Potential secret detected matching pattern: $pattern"
            echo "$MATCHES"
            echo ""
            echo "If this is a false positive, use: git commit --no-verify"
            exit 1
        fi
    done
fi

echo "Pre-commit check passed."
exit 0
